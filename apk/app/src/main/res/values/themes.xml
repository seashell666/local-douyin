<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 无动画样式，消除启动窗口退出时的过渡动画 -->
    <style name="NoAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Theme.Fullscreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- 启动窗口背景直接用开屏画面PNG（黑色+logo+文字），和HTML开屏遮罩完全一致 -->
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <!-- 禁用启动预览的默认白色背景 -->
        <item name="android:colorBackground">@android:color/black</item>
        <!-- 禁用Activity进入/退出动画，消除启动窗口退出时的一闪 -->
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
        <!-- 禁用启动窗口的退出动画 -->
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
